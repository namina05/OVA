# Postgres connection for reading the therapy_sessions view (use a server-side
# role; never ship this to the mobile app).
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Where the trained model lives (model.json + metadata.json)
OVA_MODEL_DIR=models/current
OVA_THERAPY_SESSIONS_TABLE=public.therapy_sessions
OVA_HISTORY_MAX_SESSIONS=200
OVA_PERSONALIZATION_MIN_SESSIONS=5
# Predictions within this many pain points count as a tie; the gentler setting wins.
OVA_TIE_TOLERANCE=0.1
# Names for session_zones.zone = 1,2,3,4 (confirm against the belt hardware)
OVA_ZONE_NAMES=lower_abdomen,lower_back,left_abdomen,right_abdomen

# Safety limits: either a JSON file with any SafetyLimits fields...
# OVA_SAFETY_CONFIG=config/safety.json
# ...and/or individual overrides:
# OVA_SAFETY_MIN_TEMPERATURE_C=37
# OVA_SAFETY_MAX_TEMPERATURE_C=42
# OVA_SAFETY_TEMPERATURE_STEP_C=1
# OVA_SAFETY_MIN_DURATION_MIN=10
# OVA_SAFETY_MAX_DURATION_MIN=30
# OVA_SAFETY_DURATION_STEP_MIN=5
# OVA_SAFETY_ALLOWED_ZONES=lower_abdomen,lower_back,left_abdomen,right_abdomen
# OVA_SAFETY_ALLOWED_MODES=continuous,pulse
# OVA_SAFETY_HIGH_TEMPERATURE_THRESHOLD_C=41
# OVA_SAFETY_MAX_DURATION_AT_HIGH_TEMPERATURE_MIN=20

# Cycle models (next period start, period length, pain forecast)
OVA_CYCLE_MODEL_DIR=models/cycle
# Below this many complete cycles the start date uses the recent average, not the model
OVA_MIN_CYCLES_FOR_MODEL=2
# Forecast pain at or above this is returned in high_pain_dates
OVA_HIGH_PAIN_THRESHOLD=6

# Knowledge graph: auto (Postgres when DATABASE_URL is set, else the bundled file) | file | postgres
OVA_KNOWLEDGE_GRAPH_SOURCE=auto
# How far back logged symptoms count towards health alerts
OVA_SYMPTOM_LOOKBACK_DAYS=90
# Health alerts at these care levels withhold the heat recommendation (emergency, urgent, see_doctor)
OVA_WITHHOLD_CARE_LEVELS=emergency
